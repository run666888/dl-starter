{
  "run_name": "cifar10-resnet18",
  "seed": 42,
  "device": "auto",
  "data": {
    "dataset": "cifar10",
    "root": "data",
    "image_size": 32,
    "num_classes": 10,
    "batch_size": 128,
    "num_workers": 4,
    "train_size": 50000,
    "val_size": 10000
  },
  "model": {
    "name": "resnet18",
    "width": 64,
    "dropout": 0.0
  },
  "train": {
    "epochs": 50,
    "learning_rate": 0.001,
    "weight_decay": 0.0005,
    "label_smoothing": 0.1,
    "amp": true,
    "grad_clip": 1.0,
    "output_root": "outputs/runs"
  }
}

