{
  "run_name": "smoke-xpu",
  "seed": 42,
  "device": "auto",
  "data": {
    "dataset": "synthetic",
    "root": "data",
    "image_size": 32,
    "num_classes": 10,
    "batch_size": 64,
    "num_workers": 0,
    "train_size": 512,
    "val_size": 128
  },
  "model": {
    "name": "tiny_resnet",
    "width": 24,
    "dropout": 0.1
  },
  "train": {
    "epochs": 2,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "label_smoothing": 0.05,
    "amp": true,
    "grad_clip": 1.0,
    "output_root": "outputs/runs"
  }
}

